<?xml version="1.0"?>
<workflow id="12" url="">
  <name>iMio - Fiche - Recrutement</name>
  <slug>imio-fiche-recrutement</slug>
  <roles>
    <role id="_editor">Agent traitant</role>
    <role id="_recrutement-personnel-du-service-a-l-enfance">Recrutement Personnel du service &#224; l&#8217;enfance</role>
    <role id="_recrutement-personnel-soignant">Recrutement Personnel soignant</role>
    <role id="_responsable-recrutement-personnel-administratif">Responsable recrutement Personnel administratif</role>
    <role id="_responsable-recrutement-personnel-de-cuisine">Responsable recrutement Personnel de cuisine</role>
    <role id="_responsable-recrutement-personnel-de-nettoyage">Responsable recrutement Personnel de nettoyage</role>
    <role id="_responsable-recrutement-personnel-du-service-enseignement">Responsable recrutement Personnel du service enseignement</role>
    <role id="_responsable-recrutement-personnel-ouvrier">Responsable recrutement Personnel ouvrier</role>
    <role id="_responsable-recrutement-personnel-social">Responsable recrutement Personnel social</role>
    <role id="_responsable-recrutement-personnel-technique-specifique">Responsable recrutement Personnel technique / sp&#233;cifique</role>
    <role id="_responsable-recutement-autre">Responsable recutement Autre</role>
    <role id="_viewer">Visualisateur</role>
  </roles>
  <possible_status>
    <status>
      <id>recorded</id>
      <name>Enregistr&#233;e</name>
      <colour>#FFFFFF</colour>
      <visibility />
      <items>
        <item type="dispatch" id="1">
          <role_key>_editor</role_key>
          <operation_mode>set</operation_mode>
          <dispatch_type>automatic</dispatch_type>
          <variable>form_var_section</variable>
          <rules>
            <rule>
              <role_id slug="recrutement-personnel-administratif" role_id="cfe5fb6d993f4a4ab42e35fca58edcee">Recrutement Personnel administratif</role_id>
              <value>Personnel administratif</value>
            </rule>
            <rule>
              <role_id slug="recrutement-personnel-ouvrier" role_id="dea4f5a9a5fe4d0b9b1e4e8316a4b9f7">Recrutement Personnel ouvrier</role_id>
              <value>Personnel ouvrier</value>
            </rule>
            <rule>
              <role_id slug="recrutement-personnel-social" role_id="8867e01b11054332b3449a0200fa96b3">Recrutement Personnel social</role_id>
              <value>Personnel social</value>
            </rule>
            <rule>
              <role_id slug="recrutement-personnel-technique-specifique" role_id="4960c968c7aa4fa4949a8e37daa41cc5">Recrutement Personnel technique / sp&#233;cifique</role_id>
              <value>Personnel technique / sp&#233;cifique</value>
            </rule>
            <rule>
              <role_id slug="recrutement-personnel-de-nettoyage" role_id="ee7c2ef0a98e4aad807e7e4ed665bf65">Recrutement Personnel de nettoyage</role_id>
              <value>Personnel de nettoyage</value>
            </rule>
            <rule>
              <role_id slug="recrutement-personnel-de-cuisine" role_id="61bdb5415cb44c31b789f5650fcb095a">Recrutement Personnel de cuisine</role_id>
              <value>Personnel de cuisine</value>
            </rule>
            <rule>
              <role_id slug="recrutement-personnel-du-service-enseignement" role_id="e5dff7247e774414a09c78a9606a1062">Recrutement Personnel du service enseignement</role_id>
              <value>Personnel du service enseignement</value>
            </rule>
            <rule>
              <role_id slug="recrutement-autre" role_id="9642a262e46843a7aa8877c26e5a27c7">Recrutement Autre</role_id>
              <value>Autre</value>
            </rule>
            <rule>
              <role_id slug="recrutement-personnel-soignant" role_id="f865359eed6f44e98bdd632ccecfa9a7">Recrutement Personnel soignant</role_id>
              <value>Personnel soignant</value>
            </rule>
            <rule>
              <role_id slug="recrutement-personnel-du-service-a-lenfance" role_id="ded37dcd0a414c1397d5a071fff3a7ae">Recrutement Personnel du service &#224; l&#8217;enfance</role_id>
              <value>Personnel du service &#224; l&#8217;enfance</value>
            </rule>
          </rules>
        </item>
        <item type="commentable" id="3">
          <label>Commentaire</label>
          <button_label>Ajouter le commentaire</button_label>
          <by>
            <item role_id="_editor">_editor</item>
          </by>
          <required>False</required>
        </item>
        <item type="choice" id="4">
          <label>Traiter</label>
          <by>
            <item role_id="_editor">_editor</item>
          </by>
          <status>0</status>
          <require_confirmation>True</require_confirmation>
          <ignore_form_errors>False</ignore_form_errors>
          <set_marker_on_status>False</set_marker_on_status>
          <allow_as_mass_action>False</allow_as_mass_action>
        </item>
      </items>
    </status>
    <status>
      <id>deleted</id>
      <name>Supprim&#233;e</name>
      <colour>#FFFFFF</colour>
      <visibility />
      <items>
        <item type="remove" id="1" />
      </items>
    </status>
    <status>
      <id>0</id>
      <name>Trait&#233;e</name>
      <colour>#FFFFFF</colour>
      <visibility />
      <items>
        <item type="choice" id="1">
          <label>Supprimer la fiche</label>
          <by>
            <item role_id="_editor">_editor</item>
            <item role_id="_submitter">_submitter</item>
          </by>
          <status>deleted</status>
          <require_confirmation>True</require_confirmation>
          <ignore_form_errors>False</ignore_form_errors>
          <set_marker_on_status>False</set_marker_on_status>
          <allow_as_mass_action>True</allow_as_mass_action>
        </item>
      </items>
    </status>
  </possible_status>
</workflow>