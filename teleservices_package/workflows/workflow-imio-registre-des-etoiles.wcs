  <global_actions>
    <action>
      <id>1</id>
      <name>&#128172; Ajouter un commentaire</name>
      <backoffice_info_text>&lt;p&gt;Cette action permet d&amp;rsquo;ajouter un commentaire qui sera visible par l&amp;rsquo;usager.&lt;/p&gt;</backoffice_info_text>
      <items>
        <item type="form" id="1">
          <by>
            <item role_id="_submitter">_submitter</item>
            <item role_id="_receiver">_receiver</item>
          </by>
          <varname>commentaire</varname>
          <hide_submit_button>False</hide_submit_button>
          <include_in_form_history>True</include_in_form_history>
          <formdef>
            <name>-</name>
            <fields>
              <field>
                <type>text</type>
                <label type="str">Commentaire</label>
                <required type="str">required</required>
                <varname type="str">commentaire</varname>
                <display_locations />
                <display_mode type="str">pre</display_mode>
                <id type="str">c2e0d80d-06d7-46bd-a86e-84909f19b1d6</id>
              </field>
            </fields>
          </formdef>
        </item>
      </items>
      <triggers>
        <trigger type="manual" id="d1941a82-3acc-4c34-ac46-515277efc87f">
          <roles>
            <item role_id="_submitter">_submitter</item>
            <item role_id="_receiver">_receiver</item>
          </roles>
          <statuses>
            <statuse>new</statuse>
          </statuses>
          <allow_as_mass_action>False</allow_as_mass_action>
          <require_confirmation>False</require_confirmation>
        </trigger>
      </triggers>
    </action>
  </global_actions>
</workflow>